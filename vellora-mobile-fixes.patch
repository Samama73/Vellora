diff --git a/src/lib/nativeShare.js b/src/lib/nativeShare.js
new file mode 100644
index 0000000..18c0514
--- /dev/null
+++ b/src/lib/nativeShare.js
@@ -0,0 +1,25 @@
+import { Capacitor } from "@capacitor/core";
+
+// Android/iOS Capacitor app ke andar hain ya normal browser mein?
+export const isNative = () => {
+  try { return Capacitor.isNativePlatform(); } catch { return false; }
+};
+
+const fileToBase64 = (file) =>
+  new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result).split(",")[1]);
+    reader.onerror = reject;
+    reader.readAsDataURL(file);
+  });
+
+// WebView mein navigator.share(files) / blob download kaam nahi karta,
+// isliye image ko cache mein likh ke native share sheet kholte hain.
+// "Save to Files / Drive / Gallery" bhi isi sheet se ho jata hai.
+export async function nativeShareImage(file, { title, text } = {}) {
+  const { Filesystem, Directory } = await import("@capacitor/filesystem");
+  const { Share } = await import("@capacitor/share");
+  const data = await fileToBase64(file);
+  const saved = await Filesystem.writeFile({ path: file.name, data, directory: Directory.Cache });
+  await Share.share({ title, text, files: [saved.uri], dialogTitle: "Share poster" });
+}
